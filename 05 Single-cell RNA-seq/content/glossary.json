  "entries": [
    {
      "id": "t1",
      "zh": "单细胞转录组",
      "en": "single-cell RNA sequencing",
      "abbr": "",
      "aliases": [
        "单细胞转录组",
        "single-cell RNA sequencing"
      ],
      "category": "细胞与实验",
      "summary": "分别记录不同细胞中检测到的 RNA 信号，用于观察细胞间差异。",
      "example": "本例把骨髓中不同细胞排为矩阵的不同记录。",
      "in_course": "连接计数、聚类和类型注释。",
      "pitfall": "观测不到某 RNA 不等于该细胞绝不会表达。",
      "related": [
        "t2",
        "t3",
        "t4"
      ],
      "sources": [],
      "anchor": "glossary-1"
    },
    {
      "id": "t2",
      "zh": "基因",
      "en": "gene",
      "abbr": "",
      "aliases": [
        "基因",
        "gene"
      ],
      "category": "细胞与实验",
      "summary": "具有生物学功能的一段遗传信息，可产生 RNA 等产物。",
      "example": "MS4A1 是本课检查 B 系线索的一个基因。",
      "in_course": "作为表达矩阵的特征。",
      "pitfall": "一个基因不只服务一种细胞或一种功能。",
      "related": [
        "t1",
        "t3",
        "t4"
      ],
      "sources": [],
      "anchor": "glossary-2"
    },
    {
      "id": "t3",
      "zh": "转录本",
      "en": "transcript",
      "abbr": "",
      "aliases": [
        "转录本",
        "transcript"
      ],
      "category": "细胞与实验",
      "summary": "由转录产生的 RNA 形式，同一基因可能对应多个转录本。",
      "example": "基因表达汇总可包含来自不同转录本的信号。",
      "in_course": "理解测序信号与基因计数的关系。",
      "pitfall": "基因计数通常不等于已经分清所有异构体。",
      "related": [
        "t1",
        "t2",
        "t4"
      ],
      "sources": [],
      "anchor": "glossary-3"
    },
    {
      "id": "t4",
      "zh": "RNA",
      "en": "ribonucleic acid",
      "abbr": "RNA",
      "aliases": [
        "RNA",
        "ribonucleic acid"
      ],
      "category": "细胞与实验",
      "summary": "由转录产生并参与多种生物过程的核酸，丰度由生成和降解共同决定。",
      "example": "相同细胞类型在不同状态可有不同 RNA 丰度。",
      "in_course": "本课测量对象的分子基础。",
      "pitfall": "RNA 丰度不能直接当蛋白量或瞬时转录速率。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-4"
    },
    {
      "id": "t5",
      "zh": "DNA",
      "en": "deoxyribonucleic acid",
      "abbr": "DNA",
      "aliases": [
        "DNA",
        "deoxyribonucleic acid"
      ],
      "category": "细胞与实验",
      "summary": "保存遗传信息的核酸，为许多 RNA 的产生提供模板。",
      "example": "barcode 插画中的细胞包含遗传信息，但本课输入不是 DNA 变异表。",
      "in_course": "理解转录与测序的起点。",
      "pitfall": "scRNA 计数不是 DNA 拷贝数测量。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-5"
    },
    {
      "id": "t6",
      "zh": "样本",
      "en": "sample",
      "abbr": "",
      "aliases": [
        "样本",
        "sample"
      ],
      "category": "细胞与实验",
      "summary": "按实验设计取得并记录身份的一份材料。",
      "example": "s1d1 与 s1d3 是两个输入样本标签。",
      "in_course": "核对来源、分组和组成。",
      "pitfall": "样本名不能自动透露疾病、处理或供体关系。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-6"
    },
    {
      "id": "t7",
      "zh": "生物学重复",
      "en": "biological replicate",
      "abbr": "",
      "aliases": [
        "生物学重复",
        "biological replicate"
      ],
      "category": "细胞与实验",
      "summary": "能够代表目标生物变异的独立实验单位，具体独立性由设计决定。",
      "example": "不同独立供体可为条件比较提供重复。",
      "in_course": "限制条件效应推断范围。",
      "pitfall": "同一供体的一万枚细胞不是一万个独立供体。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-7"
    },
    {
      "id": "t8",
      "zh": "技术批次",
      "en": "technical batch",
      "abbr": "",
      "aliases": [
        "技术批次",
        "technical batch"
      ],
      "category": "细胞与实验",
      "summary": "由建库、平台或处理时间等技术条件形成的分组。",
      "example": "不同捕获批次可能改变表达测量。",
      "in_course": "判断是否需要整合。",
      "pitfall": "不能把任何样本差别都称为技术批次。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-8"
    },
    {
      "id": "t9",
      "zh": "捕获文库",
      "en": "capture library",
      "abbr": "",
      "aliases": [
        "捕获文库",
        "capture library"
      ],
      "category": "细胞与实验",
      "summary": "一次细胞捕获及相应建库单位，需要用实验记录确认。",
      "example": "Scrublet 应按真实 capture_library 核对。",
      "in_course": "定义双细胞检测的运行范围。",
      "pitfall": "拆分的测序 lane 不一定是不同捕获。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-9"
    },
    {
      "id": "t10",
      "zh": "barcode",
      "en": "cell barcode",
      "abbr": "barcode",
      "aliases": [
        "barcode",
        "cell barcode"
      ],
      "category": "细胞与实验",
      "summary": "用于把测序信号归到捕获单位的序列标签。",
      "example": "来自不同文库的同一条码字符串可能重复。",
      "in_course": "标记矩阵行来源。",
      "pitfall": "条码不是天然跨样本唯一身份，也不保证一个条码只有一个细胞。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-10"
    },
    {
      "id": "t11",
      "zh": "UMI",
      "en": "unique molecular identifier",
      "abbr": "UMI",
      "aliases": [
        "UMI",
        "unique molecular identifier"
      ],
      "category": "细胞与实验",
      "summary": "分子标签，用于区分原始分子与扩增产生的重复信号。",
      "example": "同一个分子的多次 PCR 扩增不应简单数成多个原始分子。",
      "in_course": "理解原始 counts 的计数口径。",
      "pitfall": "UMI 数不是细胞内全部真实 RNA 的绝对数量。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-11"
    },
    {
      "id": "t12",
      "zh": "PCR",
      "en": "polymerase chain reaction",
      "abbr": "PCR",
      "aliases": [
        "PCR",
        "polymerase chain reaction"
      ],
      "category": "细胞与实验",
      "summary": "扩增核酸的方法，可以让少量分子产生许多拷贝供测序。",
      "example": "同一 RNA 对应 cDNA 扩增后有许多 reads。",
      "in_course": "理解 UMI 去重的必要性。",
      "pitfall": "reads 数不能无条件等同于原始分子数。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-12"
    },
    {
      "id": "t13",
      "zh": "reads",
      "en": "sequencing reads",
      "abbr": "reads",
      "aliases": [
        "reads",
        "sequencing reads"
      ],
      "category": "细胞与实验",
      "summary": "测序仪读出的序列片段观测，需经上游处理才得到表达计数。",
      "example": "本课从 counts 起步，没有重新进行 FASTQ 比对。",
      "in_course": "说明分析输入的上游来源。",
      "pitfall": "一个 read 不等于一个完整转录本或一个细胞。",
      "related": [
        "t1",
        "t2",
        "t3"
      ],
      "sources": [],
      "anchor": "glossary-13"
    },
    {
      "id": "t14",
      "zh": "红系",
      "en": "erythroid lineage",
      "abbr": "",
      "aliases": [
        "红系",
        "erythroid lineage"
      ],
      "category": "细胞与实验",
      "summary": "与红细胞生成相关的细胞谱系及阶段。",
      "example": "骨髓中 HBA1/HBB 等信号可来自真实红系群体。",
      "in_course": "解释组织特异的 marker 与 QC。",
      "pitfall": "高血红蛋白比例不能一律当污染。",
