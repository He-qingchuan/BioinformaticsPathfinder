# 阅读方式：第一类逐项目核实；第二类通常沿用，只有相应章节启用或选择另一套既有结果时才调整。
# KEY=value 的 = 两侧不留空格；注释放独立行，不写在值后面。空值表示未设置/没有该层，是否允许取决于下面
#   字段用途。
# 一个项目只有这一份配置；样本 ID、分组、重复、小时来自 samples.tsv，任意差异比较来自 contrasts.tsv，
#   不在此重复硬写。
# 路径相对能看见 0script 的项目根目录；../ 表示上一层。改变一个路径只改变后续读取位置，不会移动文件或
#   自动重算。
# 配置不承诺任意物种自动兼容：真实参考、矩阵尺度、OrgDb/KEGG ID 匹配及时间/重复设计仍需在入口核实。
# 生效方式：Bash 重新 source，R 重新 readRenviron，并重新运行参数赋值/调用段；已经保存的图、对象和旧来
#   源清单保持原样。

# 项目参数：KEY=value，注释独占一行；含空格的值加引号。
# 路径相对当前项目根目录；这里不放下载链接、样本分组或案例筛选条件。
# 改配置不会搬动/重算已有结果，修改后重新运行本章读取与调用段。

# ---------- 一、每个项目先检查（标注“仅/按需”的项目不必全部填写） ----------

# 项目显示名称；不改变样本 ID 或目录。
PROJECT_LABEL=拟南芥示例

# 必选：fastq（双端原始数据）或 matrix（已有矩阵）。
# fastq 入口的预检默认选择 05–15，matrix 默认 09–15；此字段不自动完成这些章节，时间/非模式步骤需另行选
#   择。
DATA_ENTRY=fastq

# 线程预算，正整数；按实际可用资源设置，各章可再分配样本并行数。
# 这是总预算，不是每个并行样本都独占该数；fastp/Salmon 还在 MD 中设置 sample_jobs。不要因样本增多把每
#   个进程都放到总线程数。
THREADS=24

# 矩阵入口核实：未归一化基因 counts，第 10 章检验用，不能用 TPM 冒充。
COUNT_MATRIX=3Salmon/quanti/gene.counts.matrix

# 矩阵入口按需核实：真实基因 TPM，第 16–17 章用；不用时间分析可暂不准备。
TPM_MATRIX=3Salmon/quanti/gene.TPM.not_cross_norm

# 矩阵入口按需核实：TMM 表达矩阵，第 09、13 章用；不是 raw counts。
TMM_MATRIX=3Salmon/quanti/gene.TMM.EXPR.matrix

# 仅模式物种富集需要：与物种匹配的已安装 OrgDb 包。没有时不要借用其他物种。
# 无匹配注释时不要填假的包名；可暂不运行依赖该库的富集，或按第 18–20 章的真实自建注释路线准备。
ORGDB_PACKAGE=org.At.tair.db

# 仅 GO 富集需要：输入基因在 OrgDb 中的 keyType；用 keytypes() 核实，不自动转换 ID。
ORGDB_KEYTYPE=TAIR

# 仅 KEGG 富集需要：真实物种代码，如 ath/hsa/mmu；无匹配时在分析章关闭 KEGG。
KEGG_ORGANISM=ath

# 仅 KEGG 富集需要：KEGG 支持的输入 ID 类型；不同于 OrgDb keyType。
KEGG_KEYTYPE=kegg

# ---------- 二、通常沿用默认（仅按需调整；结果位置指向实际已有文件） ----------

# 共享 eggNOG 数据库位置，仅第 18 章用；项目集合中通常共用，不重复复制。
EGGNOG_DATA_DIR=../../resources/eggnog

# 主线筛选默认 BH 阈值；调小更严格。时间/周期的局部阈值在对应章单独设置。
# 它控制哪些地方以各章实际读取为准；JTK/模块富集的独立入口阈值不自动随本值改变。改阈值不等于重新拟合差
#   异模型。
FDR_CUTOFF=0.05

# 主线绝对 log2FC 默认阈值；1 为两倍变化，调大更严格，不自动重拟合 DESeq2。
LOG2FC_CUTOFF=1

# 复现用整数种子，不是日期或采样时间；通常不改。
# 不是所有旧函数都将外部种子登记在结果身份中；需要比较另一种随机布局时用新 variant_label/输出位置，不
#   能改旧清单来绕过保护。
RANDOM_SEED=20260907

# 第 10 章设计表目录；改变样本/比较设计时避免混用旧文件。
DE_DESIGN_DIR=5DESeq2/design

# 读取已有 DESeq2 统计结果的目录；本次新统计的输出由第 10 章决定。
DE_ANALYSIS_DIR=5DESeq2/DE_analysis

# 第 11–15、19–20 章读取的合并差异表；重算后手动选择实际新文件。
DE_RESULT_FILE=5DESeq2/de_result.tsv

# 第 14 章重绘读取的 ORA 结果位置；不是自动选最新结果。
ORA_RESULT_ROOT=9Enrichment_Analysis/ORA

# 第 15 章重绘读取的 GSEA 结果位置；须与实际统计参数对应。
GSEA_RESULT_ROOT=9Enrichment_Analysis/GSEA

# 第 16 章读取的已准备 log2 聚类输入；过滤改变后选择对应文件。
# 该输入已经过 TPM 组均值过滤及 log2(TPM+1)，不能用未转换的 TPM 或 counts 表替代；没有真实时间设计时不
#   运行该支线。
TIME_INPUT_FILE=10Time_Series/clustering_input_log2.tsv

# 第 16、19 章读取的已有聚类结果根目录。
TIME_RESULT_ROOT=10Time_Series

# 已有聚类的末级变体目录；旧结果没有此层时留空，新结果按真实路径填写。
TIME_VARIANT_DIR=

# 第 17 章读取 JTK 输入和样本顺序的目录。
# 目录中包含 JTK_input.tsv 与 JTK_sample_order.tsv；cycle_use/time_hour 来自样本表，不在此配置一个对所
#   有物种通用的周期。
JTK_INPUT_DIR=10Time_Series/JTK_CYCLE

# 第 17 章曲线重绘读取的 JTK 检验目录；与输入目录不同。
# 这是已完成周期检验的目录；第 17 章绘图函数虽沿用 output_dir 变量名，也先从这里读结果，再写其 plots
#   子目录。
JTK_RESULT_ROOT=10Time_Series/JTK_CYCLE

# 第 20 章重绘读取的非模式 GSEA 目录，不与主线混用。
NONMODEL_GSEA_RESULT_ROOT=9Enrichment_Analysis/OrgDb/diamond/GSEA

# 第 19 章读取的非模式模块富集根目录。
NONMODEL_MODULE_RESULT_ROOT=9Enrichment_Analysis/OrgDb/diamond/module_enrichment

# 非模式模块富集末级变体目录；按已生成结果填写，旧案例可空。
NONMODEL_MODULE_VARIANT_DIR=

# TRUE/FALSE：只读网页是否生成本项目缩略图；可再生，不影响分析原图。
# TRUE 允许只读网页生成本项目可再生缓存；FALSE 不生成。不改变原 PNG/PDF，也不把缓存作为正式分析结果迁
#   移。
VIEWER_THUMBNAILS=TRUE
